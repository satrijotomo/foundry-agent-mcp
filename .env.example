# Copy this file to .env and replace the placeholders with your Foundry settings.
# Authentication uses DefaultAzureCredential; do not add keys or tokens here.
FOUNDRY_PROJECT_ENDPOINT=https://<your-project-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_AGENT_NAME=<your-agent-name>

# Optional maximum code excerpt size in characters. Defaults to 20000.
FOUNDRY_MAX_CODE_CHARS=20000